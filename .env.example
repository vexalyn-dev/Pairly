# ==============================================================================
# PAIRLY ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Duplicate this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local or secret keys into Git version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE SUPABASE VARIABLES (Safe for Browser & Client-side)
# ------------------------------------------------------------------------------
# Your unique Supabase project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous / Publishable Key
# Safe to expose in the browser. Protected by PostgreSQL Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key-here

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (STRICTLY CONFIDENTIAL - NEVER EXPOSE TO BROWSER!)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Admin Access - Bypasses ALL Row Level Security)
# Only accessible in Node.js server environments, Server Actions, or Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# ------------------------------------------------------------------------------
# 3. APPLICATION RUNTIME SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
